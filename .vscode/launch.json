    "version": "0.2.0",
    "configurations": [
        {
            "name": "virtlab up",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "args": [
                "up", "--config", "${workspaceFolder}/config.local.yaml"
            ],
            "program": "${workspaceFolder}/cmd/virtlab"
        },
        {
            "name": "virtlab down",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "args": [
                "down", "--config", "${workspaceFolder}/config.local.yaml"
            ],
            "program": "${workspaceFolder}/cmd/virtlab"
        }
    ]
}